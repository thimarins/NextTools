{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Única capability da janela principal: comandos do NextTool explicitamente listados, eventos, janela e diálogo de seleção de pasta/arquivo. Sem acesso genérico a arquivos, shell ou rede.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-app-info",
    "allow-app-quit",
    "allow-overview",
    "allow-tasks-list",
    "allow-task-get",
    "allow-task-pause",
    "allow-task-resume",
    "allow-task-cancel",
    "allow-size-scan-submit",
    "allow-snapshot-summary",
    "allow-snapshot-list-dir",
    "allow-snapshot-list-subdirs",
    "allow-snapshot-dir-info",
    "allow-snapshots-list",
    "allow-snapshot-set-label",
    "allow-snapshot-delete",
    "allow-snapshot-import",
    "allow-snapshot-export",
    "allow-snapshot-build-indexes",
    "allow-snapshot-compare",
    "allow-owners-lookup",
    "allow-schedules-list",
    "allow-schedule-create",
    "allow-schedule-set-enabled",
    "allow-schedule-delete",
    "allow-snapshot-top-files",
    "allow-snapshot-top-dirs",
    "allow-snapshot-query",
    "allow-snapshot-cancel-query",
    "allow-snapshot-stats",
    "allow-copy-plan",
    "allow-copy-submit",
    "allow-alerts-list",
    "allow-alerts-ack",
    "allow-settings-get",
    "allow-settings-set"
  ]
}
